<Ui xmlns="http://www.blizzard.com/wow/ui/">

	<!-- The list dialog (listdialog.lua): a new list, editing one, export, import and delete, in
	     the popups' look, centered on the main window. The mode decides which parts show; the
	     mixin stacks the shown ones below the title and sizes the frame.
	         Title                                        [x]
	         Message (wrapped)
	         [Name ...................]                     create / edit
	         (star)(circle)(diamond)... the eight markers   create / edit
	         [x] Show in item tooltips                      create / edit
	         [ the export string / the pasted text,        export / import
	           in a dark box, scrolling                 ]
	                                           [ Accept ] -->
	<Frame name="SpyglassListDialog" mixin="SpyglassListDialogMixin" inherits="SpyglassPopupTemplate"
		parent="SpyglassMainWindow">
		<Size x="320" y="200"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Message" inherits="GameFontHighlight" justifyH="LEFT" hidden="true">
					<Size x="296" y="0"/>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox parentKey="NameBox" inherits="InputBoxTemplate" autoFocus="false" letters="40" hidden="true">
				<Size x="220" y="20"/>
			</EditBox>
			<!-- The marker buttons are made by the mixin. -->
			<Frame parentKey="Markers" hidden="true">
				<Size x="208" y="22"/>
			</Frame>
			<CheckButton parentKey="TooltipCheck" inherits="SpyglassInfoCheckboxTemplate" hidden="true"/>
			<Frame parentKey="TextFrame" hidden="true">
				<Size x="296" y="120"/>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture setAllPoints="true">
							<Color r="0" g="0" b="0" a="0.5"/>
						</Texture>
					</Layer>
				</Layers>
				<Frames>
					<Frame parentKey="Text" inherits="ScrollingEditBoxTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="6" y="-6"/>
							<Anchor point="BOTTOMRIGHT" x="-6" y="6"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>
			<Button parentKey="Accept" inherits="SpyglassInfoButtonTemplate">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-12" y="12"/>
				</Anchors>
			</Button>
		</Frames>
	</Frame>
</Ui>
