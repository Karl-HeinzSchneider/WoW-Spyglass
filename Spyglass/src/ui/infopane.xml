<Ui xmlns="http://www.blizzard.com/wow/ui/">

	<!-- The window's right pane: the info panel of what the selected tab shows. Modeled on the
	     character frame's side pane (Blizzard_UIPanels_Game/Camelot/CharacterFrame.xml): a
	     title, the scroll-line divider, then the widgets stacked below it. The widget templates
	     remake that pane's rows with the same art; each is pooled by SpyglassInfoPaneMixin. -->

	<!-- header: the stat-category plate, white centered text. -->
	<Frame name="SpyglassInfoHeaderTemplate" virtual="true">
		<Size x="210" y="40"/>
		<KeyValues>
			<KeyValue key="align" value="center" type="string"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture atlas="UI-Character-Info-Title" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlight" justifyH="CENTER" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="12" y="1"/>
						<Anchor point="RIGHT" x="-12" y="1"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- text / description: white text wrapped to the pane's width; the mixin sets the height.
	     The width is fixed on the FontString itself (as on the character frame's wrapped side-pane
	     row): the row isn't placed yet when the text is measured, so a width from anchors would
	     measure as one line. -->
	<Frame name="SpyglassInfoTextTemplate" virtual="true">
		<Size x="228" y="16"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
					<Size x="228" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- row: gold label on the left, white value on the right. -->
	<Frame name="SpyglassInfoRowTemplate" virtual="true">
		<Size x="228" y="18"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="2" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Value" inherits="GameFontHighlight" justifyH="RIGHT" wordwrap="false">
					<Anchors>
						<Anchor point="RIGHT" x="-2" y="0"/>
						<Anchor point="LEFT" relativeKey="$parent.Label" relativePoint="RIGHT" x="8" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- item: icon and name of a quest starting item; hover shows the game's item tooltip. -->
	<Button name="SpyglassInfoItemTemplate" virtual="true">
		<Size x="228" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="22" y="22"/>
					<Anchors>
						<Anchor point="LEFT" x="2"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Name" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="6"/>
						<Anchor point="RIGHT" x="-2"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<!-- bar: the skill / reputation bar of the character frame's detail panes. -->
	<Frame name="SpyglassInfoBarTemplate" inherits="ColoredProgressBarTemplate" virtual="true">
		<Size x="180" y="29"/>
		<KeyValues>
			<KeyValue key="align" value="center" type="string"/>
		</KeyValues>
	</Frame>

	<!-- checkbox: the minimal checkbox of the reputation detail pane, its label to the right
	     (clickable too: the hit rect runs under it). -->
	<CheckButton name="SpyglassInfoCheckboxTemplate" virtual="true">
		<Size x="26" y="26"/>
		<HitRectInsets>
			<AbsInset left="0" right="-196" top="0" bottom="0"/>
		</HitRectInsets>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
					<Size x="196" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="2" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<NormalTexture atlas="checkbox-minimal" useAtlasSize="true"/>
		<PushedTexture atlas="checkbox-minimal" useAtlasSize="true"/>
		<CheckedTexture atlas="checkmark-minimal" useAtlasSize="true"/>
		<DisabledCheckedTexture atlas="checkmark-minimal-disabled" useAtlasSize="true"/>
	</CheckButton>

	<!-- dropdown: gold label on the left, the dropdown button on the right. -->
	<Frame name="SpyglassInfoDropdownTemplate" virtual="true">
		<Size x="228" y="30"/>
		<Frames>
			<DropdownButton parentKey="Dropdown" inherits="WowStyle1DropdownTemplate">
				<Size x="130" y="26"/>
				<Anchors>
					<Anchor point="RIGHT" x="-2" y="0"/>
				</Anchors>
			</DropdownButton>
		</Frames>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Size x="88" y="0"/>
					<Anchors>
						<Anchor point="LEFT" x="2" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- Query dropdowns use the selection-text style, so the chosen value stays visible. -->
	<Frame name="SpyglassInfoQueryDropdownTemplate" virtual="true">
		<Size x="228" y="30"/>
		<Frames>
			<DropdownButton parentKey="Dropdown" inherits="WowStyle1DropdownTemplate">
				<Size x="130" y="26"/>
				<Anchors><Anchor point="RIGHT" x="-2"/></Anchors>
			</DropdownButton>
		</Frames>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Size x="88" y="0"/>
					<Anchors><Anchor point="LEFT" x="2"/></Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- Search and result count for a query folder. -->
	<Frame name="SpyglassInfoSearchTemplate" virtual="true">
		<Size x="228" y="50"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormal" text="Search">
					<Anchors><Anchor point="TOPLEFT" x="2" y="-2"/></Anchors>
				</FontString>
				<FontString parentKey="Count" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Anchors><Anchor point="TOPRIGHT" x="-2" y="-3"/></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox parentKey="Box" inherits="SearchBoxTemplate" mixin="SpyglassSearchBoxMixin" letters="40" autoFocus="false">
				<Size x="220" y="22"/>
				<Anchors><Anchor point="BOTTOM" y="2"/></Anchors>
				<Scripts><OnTextChanged inherit="prepend" method="OnTextChanged"/></Scripts>
			</EditBox>
		</Frames>
	</Frame>

	<!-- Range label and Min/Max captions sit above the two inputs. -->
	<Frame name="SpyglassInfoRangeTemplate" virtual="true">
		<Size x="228" y="42"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Size x="106" y="0"/>
					<Anchors><Anchor point="TOPLEFT" x="2" y="-2"/></Anchors>
				</FontString>
				<FontString inherits="GameFontHighlight" text="–">
					<Anchors><Anchor point="CENTER" x="50" y="-7"/></Anchors>
				</FontString>
				<FontString inherits="GameFontHighlightSmall" text="Min" justifyH="CENTER">
					<Size x="48" y="0"/>
					<Anchors><Anchor point="TOPLEFT" x="102" y="-2"/></Anchors>
				</FontString>
				<FontString inherits="GameFontHighlightSmall" text="Max" justifyH="CENTER">
					<Size x="48" y="0"/>
					<Anchors><Anchor point="TOPRIGHT" x="-2" y="-2"/></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox parentKey="Min" inherits="InputBoxTemplate" autoFocus="false" letters="4">
				<Size x="48" y="22"/>
				<Anchors><Anchor point="LEFT" x="102" y="-7"/></Anchors>
			</EditBox>
			<EditBox parentKey="Max" inherits="InputBoxTemplate" autoFocus="false" letters="4">
				<Size x="48" y="22"/>
				<Anchors><Anchor point="RIGHT" x="-2" y="-7"/></Anchors>
			</EditBox>
		</Frames>
	</Frame>

	<!-- button: the reputation detail pane's small gold button. -->
	<Button name="SpyglassInfoButtonTemplate" inherits="SharedGoldRedButtonSmallTemplate" virtual="true">
		<Size x="180" y="22"/>
		<KeyValues>
			<KeyValue key="align" value="center" type="string"/>
		</KeyValues>
		<!-- A label of its own, as wide as the button's inside and on one line: the engine's
		     default one sizes itself to the text, and after a click it could come out a few
		     pixels too narrow in the normal font and break the word ("Expor" / "t"). -->
		<ButtonText parentKey="Text" wordwrap="false">
			<Size x="164" y="0"/>
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</ButtonText>
		<NormalFont style="GameFontNormalSmall"/>
		<HighlightFont style="GameFontWhiteSmall"/>
		<DisabledFont style="GameFontDisableSmall"/>
	</Button>

	<!-- quests: one line per quest, the title (wrapped, fixed width like the text widget) on the
	     left and the character's progress on the right; the mixin sets the height. Hovering shows
	     the quest's tooltip, a modified click links it in chat, as a quest link in chat does. -->
	<Button name="SpyglassInfoQuestTemplate" virtual="true">
		<Size x="228" y="16"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Title" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
					<Size x="156" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Status" inherits="GameFontHighlightSmall" justifyH="RIGHT" wordwrap="false">
					<Size x="66" y="0"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-2" y="-1"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<!-- spacer: empty space; the mixin sets the height. -->
	<Frame name="SpyglassInfoSpacerTemplate" virtual="true">
		<Size x="228" y="8"/>
	</Frame>

	<Frame name="SpyglassInfoPaneTemplate" mixin="SpyglassInfoPaneMixin" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Title" inherits="GameFontNormalMed3" justifyH="CENTER">
					<Size x="228" y="0"/>
					<Anchors>
						<Anchor point="TOP"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Divider" atlas="UI-Character-Info-ScrollLine" useAtlasSize="true">
					<Anchors>
						<Anchor point="TOP" relativeKey="$parent.Title" relativePoint="BOTTOM" y="-4"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="Content" inherits="VerticalLayoutFrame">
				<KeyValues>
					<KeyValue key="spacing" value="4" type="number"/>
					<KeyValue key="fixedWidth" value="228" type="number"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOP" relativeKey="$parent.Divider" relativePoint="BOTTOM" y="-6"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>
</Ui>
