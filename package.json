{
  "name": "wow-spyglass",
  "private": true,
  "version": "0.1.0",
  "description": "Spyglass addon monorepo and data-generation tools",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "tsx src/cli.ts generate",
    "generate": "tsx src/cli.ts generate",
    "generate:check": "tsx src/cli.ts generate --check",
    "check": "npm run typecheck && npm run test:tooling && npm run check:addons && npm run check:data && npm run generate:check && npm run check:lua && npm run check:xml",
    "check:addons": "tsx src/check-addons.ts",
    "check:data": "tsx src/cli.ts check",
    "check:lua": "tsx src/check-lua.ts",
    "check:xml": "tsx src/check-xml.ts",
    "test:tooling": "tsx --test tests/tooling/*.test.ts",
    "fix": "tsx src/cli.ts check --fix",
    "format": "prettier --write . && stylua .",
    "import": "tsx src/cli.ts import",
    "typecheck": "tsc --noEmit",
    "dev:link": "tsx src/link-addons.ts",
    "package:addons": "tsx src/package-addons.ts",
    "package:local": "tsx src/package-local.ts"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "@types/node": "^22.0.0",
    "csv-parse": "^7.0.2",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
