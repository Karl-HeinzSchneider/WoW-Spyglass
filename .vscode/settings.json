{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "xml.format.maxLineWidth": 120,
  "xml.format.splitAttributes": "preserve",
  "files.associations": {
    "*.toc": "properties"
  },
  "Lua.runtime.version": "Lua 5.1",
  "Lua.runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "Lua.workspace.library": [
    "~\\.vscode\\extensions\\ketho.wow-api-0.22.3\\Annotations\\Core"
  ],
  "Lua.diagnostics.globals": [
    "DEFAULT_CHAT_FRAME",
    "SELECTED_CHAT_FRAME",
    "UIParent",
    "NORMAL_FONT_COLOR",
    "GameFontNormal",
    "GameFontHighlight",
    "ACCEPT",
    "CANCEL",
    "Settings",
    "GameFontHighlightLarge",
    "GameFontHighlightSmall",
    "SlashCmdList",
    "hash_SlashCmdList",
    "NORMAL_FONT_COLOR_CODE",
    "FONT_COLOR_CODE_CLOSE",
    "CLOSE",
    "GameFontDisableSmall",
    "GameTooltip",
    "GameFontNormalSmall",
    "WOW_PROJECT_ID",
    "WOW_PROJECT_MAINLINE",
    "ColorPickerFrame",
    "ChatEdit_InsertLink",
    "ChatFontNormal",
    "OKAY",
    "ChatFrameUtil",
    "NOT_BOUND",
    "IsSecureCmd",
    "NUM_CHAT_WINDOWS",
    "ChatEdit_GetActiveWindow",
    "Minimap",
    "AddonCompartmentFrame",
    "INFO",
    "NONE"
  ]
}
