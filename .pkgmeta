# BigWigs packager (https://github.com/BigWigsMods/packager), used by .github/workflows/ and
# `npm run package:local`.
#
# The repository holds four addons side by side. The packager copies the whole checkout into
# .release/Spyglass/, then move-folders lifts every addon to the top of the zip. Whatever the
# ignore list below lets through at the root ends up inside the core's folder, so every root
# entry that is not an addon has to be ignored here. Dotfiles/dot-folders (.contribute, .github,
# .vscode, ...) and everything git ignores (node_modules, .cache, dist, .release) are skipped
# by the packager on its own.
#
# The CurseForge / Wago / WoWInterface project ids are read from Spyglass/Spyglass.toc
# (## X-Curse-Project-ID, ## X-Wago-ID, ## X-WoWI-ID).

package-as: Spyglass

move-folders:
  Spyglass/Spyglass: Spyglass
  Spyglass/Spyglass_Database: Spyglass_Database
  Spyglass/Spyglass_Locale: Spyglass_Locale
  Spyglass/Spyglass_Scraper: Spyglass_Scraper

ignore:
  # Root tooling (the root src/ would also collide with Spyglass/src/ when the core is moved).
  - docs
  - src
  - tests
  - tools
  - package.json
  - package-lock.json
  - tsconfig.json
  - stylua.toml
  # Claude Code guidance: the root one and the one in every addon.
  - CLAUDE.md
  - "*/CLAUDE.md"
  # Any other Markdown, at any depth.
  - "*.md"
  # LuaLS annotation files; no TOC loads them.
  - Spyglass/src/types.lua
  - Spyglass/src/types_blizzard.lua
  - Spyglass_Scraper/src/types.lua
