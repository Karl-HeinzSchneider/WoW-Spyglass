<Ui xmlns="http://www.blizzard.com/wow/ui/">

	<!-- Modeled on Blizzard_PlayerSpells/Camelot/Blizzard_PlayerSpellsFrame.xml -->
	<Frame name="ForeverLootMainWindow" mixin="ForeverLootMainWindowMixin"
		inherits="PortraitFrameTemplate, TabSystemOwnerTemplate"
		parent="UIParent" toplevel="true" enableMouse="true" movable="true" clampedToScreen="true" hidden="true">
		<KeyValues>
			<!-- Geometry from PlayerSpellsFrame (camelot), narrowed: Blizzard uses window
			     1618x720 / 809 minimized and book art 1612x702 / 806. We keep the same 3px/6px
			     window-to-book margins and the book anchored 14px below the top, 4px above the
			     bottom; only the widths differ (one page = 697). Height is unchanged. -->
			<KeyValue key="minimizedWidth" value="700" type="number"/>
			<KeyValue key="maximizedWidth" value="1400" type="number"/>
			<KeyValue key="bookMinimizedWidth" value="697" type="number"/>
			<KeyValue key="bookMaximizedWidth" value="1394" type="number"/>
		</KeyValues>
		<Size x="700" y="720"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Frames>
			<Frame parentKey="MaximizeMinimizeButton" inherits="MaximizeMinimizeButtonFrameTemplate">
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.CloseButton" relativePoint="LEFT" x="0" y="0"/>
				</Anchors>
			</Frame>
			<!-- Hangs off the bottom edge, exactly like PlayerSpellsFrame. -->
			<Frame parentKey="TabSystem" inherits="TabSystemTemplate">
				<KeyValues>
					<KeyValue key="minTabWidth" value="100" type="number"/>
					<KeyValue key="maxTabWidth" value="150" type="number"/>
					<KeyValue key="tabSelectSound" value="SOUNDKIT.UI_CLASS_TALENT_TAB" type="global"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="BOTTOMLEFT" x="22" y="2"/>
				</Anchors>
			</Frame>
			<!-- Views are created from ForeverLootViewTemplate and fill this area. -->
			<!-- The "book": same placement as SpellBookFrame inside PlayerSpellsFrame. Width is set
			     in Lua (bookMinimizedWidth / bookMaximizedWidth). -->
			<Frame parentKey="ViewContainer">
				<Size x="697" y="702"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="0" y="-14"/>
					<Anchor point="BOTTOMLEFT" x="0" y="4"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
		</Scripts>
	</Frame>
</Ui>
