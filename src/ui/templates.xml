<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<!-- One row in a page: [icon] Name ............ [>] (arrow only for folders) -->
	<Button name="ForeverLootListRowTemplate" mixin="ForeverLootListRowMixin" virtual="true">
		<Size x="200" y="40"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="32" y="32"/>
					<Anchors>
						<Anchor point="LEFT" x="6" y="0"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Arrow" atlas="common-icon-forwardarrow" useAtlasSize="false">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="RIGHT" x="-10" y="0"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Name" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="8" y="0"/>
						<Anchor point="RIGHT" relativeKey="$parent.Arrow" relativePoint="LEFT" x="-4" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-2"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>

	<!-- One segment of the breadcrumb trail. Width follows the text (set in Init). -->
	<Button name="ForeverLootBreadcrumbButtonTemplate" mixin="ForeverLootBreadcrumbButtonMixin" virtual="true">
		<Size x="50" y="24"/>
		<ButtonText parentKey="Text">
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</ButtonText>
		<NormalFont style="GameFontNormal"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontHighlight"/>
		<Scripts>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>

	<Frame name="ForeverLootBreadcrumbSeparatorTemplate" virtual="true">
		<Size x="12" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GameFontDisable" text="&#8250;">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- One book page. The atlas is chosen in Lua (camelot vs mainline art). -->
	<Frame name="ForeverLootPageTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>

	<!-- A view: breadcrumb bar on top, two book pages below, page controls bottom-right. -->
	<Frame name="ForeverLootViewTemplate" mixin="ForeverLootViewMixin" virtual="true">
		<KeyValues>
			<KeyValue key="rowHeight" value="40" type="number"/>
			<KeyValue key="pageInsetTop" value="50" type="number"/>
			<KeyValue key="pageInsetBottom" value="60" type="number"/>
			<KeyValue key="pageInsetLeft" value="60" type="number"/>
			<KeyValue key="pageInsetRight" value="50" type="number"/>
		</KeyValues>
		<Frames>
			<Button parentKey="BackButton">
				<Size x="24" y="24"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="14" y="-10"/>
				</Anchors>
				<NormalTexture atlas="common-icon-backarrow"/>
				<HighlightTexture atlas="common-icon-backarrow" alphaMode="ADD"/>
				<DisabledTexture atlas="common-icon-backarrow" alpha="0.3"/>
			</Button>
			<Frame parentKey="Breadcrumbs" inherits="HorizontalLayoutFrame">
				<KeyValues>
					<KeyValue key="spacing" value="2" type="number"/>
				</KeyValues>
				<Size x="1" y="24"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.BackButton" relativePoint="RIGHT" x="10" y="0"/>
				</Anchors>
			</Frame>
			<Frame parentKey="LeftPage" inherits="ForeverLootPageTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="0" y="-44"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame parentKey="RightPage" inherits="ForeverLootPageTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOP" x="0" y="-44"/>
					<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame parentKey="PagingControls" inherits="PagingControlsHorizontalTemplate">
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-60" y="18"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
		</Scripts>
	</Frame>
</Ui>
