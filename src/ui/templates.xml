<Ui xmlns="http://www.blizzard.com/wow/ui/">


	<!-- One row in a page: [icon] Name ............ [>] (arrow only for folders) -->
	<Button name="ForeverLootListRowTemplate" mixin="ForeverLootListRowMixin" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true">
		<Size x="200" y="40"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="32" y="32"/>
					<Anchors>
						<Anchor point="LEFT" x="6" y="0"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Arrow" atlas="common-icon-forwardarrow" useAtlasSize="false">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="RIGHT" x="-10" y="0"/>
					</Anchors>
				</Texture>
				<!-- Same fonts as SpellBookItemTemplate's Name / SubName; colors set in Lua. -->
				<FontString parentKey="Name" inherits="SystemFont_Large" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="8" y="0"/>
						<Anchor point="RIGHT" relativeKey="$parent.Arrow" relativePoint="LEFT" x="-4" y="0"/>
					</Anchors>
				</FontString>
				<!-- Optional second line (description / item level); when shown, Name moves up. -->
				<FontString parentKey="Sub" inherits="SystemFont_Med1" justifyH="LEFT" wordwrap="false" hidden="true">
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeKey="$parent.Icon" relativePoint="BOTTOMRIGHT" x="8" y="2"/>
						<Anchor point="RIGHT" relativeKey="$parent.Arrow" relativePoint="LEFT" x="-4" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-2"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<!-- Group label: a row-sized text line with a thin divider, used to cluster entries
	     without the weight of a full page header. -->
	<Frame name="ForeverLootGroupLabelTemplate" mixin="ForeverLootGroupLabelMixin" virtual="true">
		<Size x="200" y="40"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontNormalMed2" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="6" y="2"/>
						<Anchor point="RIGHT" x="-6" y="2"/>
					</Anchors>
				</FontString>
				<Texture parentKey="Line" atlas="spellbook-divider">
					<Size y="8"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-20" y="2"/>
						<Anchor point="BOTTOMRIGHT" x="-20" y="2"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<!-- Section header inside a page; modeled on Blizzard_PlayerSpells' SpellBookHeaderTemplate. -->
	<Frame name="ForeverLootPageHeaderTemplate" mixin="ForeverLootPageHeaderMixin" virtual="true">
		<Size x="300" y="51"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Backplate" atlas="spellbook-list-backplate" alpha="0.65">
					<Size x="416" y="106"/>
					<Anchors>
						<Anchor point="LEFT" x="-85" y="10"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="SystemFont_Huge2" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" x="-8" y="0"/>
						<Anchor point="TOPRIGHT" x="-60" y="0"/>
					</Anchors>
				</FontString>
				<Texture parentKey="Border" atlas="spellbook-divider">
					<Size y="11"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-32" y="0"/>
						<Anchor point="BOTTOMRIGHT" x="-60" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<!-- One segment of the breadcrumb trail. Width follows the text (set in Init). -->
	<Button name="ForeverLootBreadcrumbButtonTemplate" mixin="ForeverLootBreadcrumbButtonMixin" virtual="true">
		<Size x="50" y="24"/>
		<ButtonText parentKey="Text">
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</ButtonText>
		<!-- The bar sits above the page header area, where the standard yellow reads fine. -->
		<NormalFont style="GameFontNormal"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontHighlight"/>
		<Scripts>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>

	<!-- Separator between crumbs: the same arrow atlas as the rows, dimmed. -->
	<Frame name="ForeverLootBreadcrumbSeparatorTemplate" virtual="true">
		<Size x="18" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture atlas="common-icon-forwardarrow" useAtlasSize="false" alpha="0.6">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!-- One book page. The atlas is chosen in Lua (camelot vs mainline art).
	     Insets (set per instance) define the content slot, like PagedSpellsView1/2Template. -->
	<Frame name="ForeverLootPageTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="insetLeft" value="85" type="number"/>
			<KeyValue key="insetRight" value="41" type="number"/>
			<KeyValue key="insetTop" value="95" type="number"/>
			<KeyValue key="insetBottom" value="72" type="number"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>

	<!-- A view: breadcrumb bar on top, two book pages below, page controls bottom-right.
	     Mouse wheel turns pages; right-click anywhere goes one level back. -->
	<Frame name="ForeverLootViewTemplate" mixin="ForeverLootViewMixin" enableMouse="true" virtual="true">
		<KeyValues>
			<!-- Spacing from the spellbook's PagedSpellsFrame: xPadding 15, yPadding 10. -->
			<KeyValue key="rowHeight" value="40" type="number"/>
			<KeyValue key="headerHeight" value="51" type="number"/>
			<KeyValue key="headerGap" value="10" type="number"/>
			<KeyValue key="columnGap" value="15" type="number"/>
		</KeyValues>
		<Frames>
			<Button parentKey="BackButton">
				<Size x="24" y="24"/>
				<!-- Where the spellbook puts its category tabs. -->
				<Anchors>
					<Anchor point="TOPLEFT" x="70" y="-26"/>
				</Anchors>
				<NormalTexture atlas="common-icon-backarrow"/>
				<HighlightTexture atlas="common-icon-backarrow" alphaMode="ADD"/>
				<DisabledTexture atlas="common-icon-backarrow" alpha="0.3"/>
			</Button>
			<Frame parentKey="Breadcrumbs" inherits="HorizontalLayoutFrame">
				<KeyValues>
					<KeyValue key="spacing" value="2" type="number"/>
				</KeyValues>
				<Size x="1" y="24"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.BackButton" relativePoint="RIGHT" x="10" y="0"/>
				</Anchors>
			</Frame>
			<!-- Pages fill the view; the breadcrumb bar above is drawn over the page art.
			     Content slots: 680x590 at (85,-95) on the left page and TOPRIGHT (-50,-95) on the
			     right page, i.e. PagedSpellsView1/2Template. The bottom inset is larger than
			     Blizzard's 17 to keep rows off the paging controls / page-curl corner. -->
			<Frame parentKey="LeftPage" inherits="ForeverLootPageTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="0" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame parentKey="RightPage" inherits="ForeverLootPageTemplate">
				<KeyValues>
					<KeyValue key="insetLeft" value="76" type="number"/>
					<KeyValue key="insetRight" value="50" type="number"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOP" x="0" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame parentKey="PagingControls" inherits="PagingControlsHorizontalTemplate">
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-75" y="40"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnMouseWheel method="OnMouseWheel"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>
</Ui>
