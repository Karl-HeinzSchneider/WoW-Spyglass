<Ui xmlns="http://www.blizzard.com/wow/ui/">

	<!-- The character wearing the hovered item, under the item's tooltip while ctrl is held.
	     As wide as the tooltip (anchored in modelpreview.lua); the recipe popup's look: tooltip
	     border around the main window's pane background, the translucent backdrop switched off.
	     Takes no mouse input. -->
	<Frame name="ForeverLootModelPreview" mixin="ForeverLootModelPreviewMixin" inherits="TooltipBorderedFrameTemplate"
		parent="UIParent" frameStrata="TOOLTIP" hidden="true">
		<Size x="200" y="240"/>
		<KeyValues>
			<KeyValue key="backdropColorAlpha" value="0" type="number"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture atlas="UI-Character-Info-General-BG">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-3"/>
						<Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<ModelScene parentKey="ModelScene" inherits="NonInteractableModelSceneMixinTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-4"/>
					<Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
				</Anchors>
			</ModelScene>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnUpdate method="OnUpdate"/>
		</Scripts>
	</Frame>
</Ui>
